# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# PostgreSQL (Primary Relational Database Configuration)
DATABASE_URL="postgresql://postgres:password@localhost:5432/artist_music_db"

# Authentication & Session Security
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_chars
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Initial Admin Bootstrap
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
REQUIRE_CUSTOM_ADMIN_PASSWORD=false

# Google OAuth 2.0 (Google Drive API v3 Storage for "Musics" and "Images" folders)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive

# Google Token Encryption (32-byte hex or 32-char secret for AES-256-GCM)
GOOGLE_TOKEN_ENCRYPTION_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Upload Limits
MAX_MUSIC_FILE_SIZE_MB=100

# Application Security
ALLOWED_ORIGINS=http://localhost:3000

# Gemini API Key (AI Studio Runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
